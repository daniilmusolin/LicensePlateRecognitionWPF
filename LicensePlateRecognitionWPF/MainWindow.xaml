<Window x:Class="LicensePlateRecognitionWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPlate Vision - Распознавание номеров"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#2D2D30">

    <Window.Resources>
        <!-- Цвета темы -->
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="DarkBackground" Color="#252526"/>
        <SolidColorBrush x:Key="LightBackground" Color="#3E3E42"/>
        <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#F44336"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#555555"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource LightBackground}" 
                                CornerRadius="8" 
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,10"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Стиль для ListView -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ - ВИДЕО -->
        <Border Grid.Column="0" 
                Background="Black" 
                CornerRadius="10" 
                Margin="0,0,10,0"
                BorderBrush="#555555"
                BorderThickness="1">
            <Grid>
                <Image x:Name="VideoImage" 
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

                <!-- Оверлей для рамки номера -->
                <Border x:Name="PlateOverlay"
                        BorderBrush="{StaticResource SuccessColor}"
                        BorderThickness="3"
                        CornerRadius="5"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>

                <!-- Статус поверх видео -->
                <Border Background="#80000000" 
                        CornerRadius="5" 
                        Padding="10,5"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="10">
                    <TextBlock x:Name="VideoStatus" 
                               Text="Готов" 
                               Foreground="White"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ПАНЕЛЬ - УПРАВЛЕНИЕ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Группа: Управление камерой -->
                <GroupBox Header="🎥 RTSP Камера">
                    <StackPanel>
                        <TextBlock Text="RTSP URL:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRtspUrl" 
                                 Text="rtsp://wowzaec2demo.streamlock.net/vod/mp4:BigBuckBunny_115k.mp4"/>

                        <TextBlock Text="Шаблон:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <ComboBox x:Name="CmbPreset" SelectedIndex="0">
                            <ComboBoxItem Content="Пользовательский"/>
                            <ComboBoxItem Content="Hikvision"/>
                            <ComboBoxItem Content="Dahua"/>
                            <ComboBoxItem Content="Axis"/>
                            <ComboBoxItem Content="Тестовый поток"/>
                        </ComboBox>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnStart" 
                                    Grid.Column="0"
                                    Content="▶ СТАРТ"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnStart_Click"
                                    Margin="0,0,5,0"/>
                            <Button x:Name="BtnStop" 
                                    Grid.Column="1"
                                    Content="⏹ СТОП"
                                    Style="{StaticResource DangerButton}"
                                    Click="BtnStop_Click"
                                    IsEnabled="False"/>
                        </Grid>

                        <Border Background="#3E3E42" 
                                CornerRadius="5" 
                                Padding="10" 
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblCameraStatus" 
                                           Text="Статус: не подключен"
                                           Foreground="{StaticResource WarningColor}"
                                           FontSize="12"/>
                                <TextBlock x:Name="LblResolution" 
                                           Text="Разрешение: -"
                                           FontSize="11"
                                           Foreground="#888888"/>
                                <TextBlock x:Name="LblFps" 
                                           Text="FPS: -"
                                           FontSize="11"
                                           Foreground="#888888"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Группа: Загрузка изображений -->
                <GroupBox Header="📷 Изображение">
                    <StackPanel>
                        <Button x:Name="BtnLoadImage" 
                                Content="📁 Загрузить изображение"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnLoadImage_Click"/>
                        <Button x:Name="BtnRecognize" 
                                Content="🔍 Распознать номер"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnRecognize_Click"
                                IsEnabled="False"
                                Margin="0,5,0,0"/>
                        <ProgressBar x:Name="ProgressBar" 
                                     Height="3" 
                                     Margin="0,5,0,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Foreground="{StaticResource AccentColor}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Группа: Результат -->
                <GroupBox Header="📄 Результат">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="НОМЕР:" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPlateNumber" 
                                     Grid.Column="1"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     FontFamily="Consolas"
                                     IsReadOnly="True"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="РЕГИОН:" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRegion" 
                                     Grid.Column="1"
                                     IsReadOnly="True"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="ТОЧНОСТЬ:" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <ProgressBar x:Name="ConfidenceBar" 
                                         Grid.Column="1"
                                         Height="20"
                                         Value="0"
                                         Foreground="{StaticResource SuccessColor}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnCopy" 
                                    Grid.Column="0"
                                    Content="📋 Копировать"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnCopy_Click"
                                    IsEnabled="False"
                                    Margin="0,0,5,0"/>
                            <Button x:Name="BtnSaveFrame" 
                                    Grid.Column="1"
                                    Content="💾 Сохранить кадр"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnSaveFrame_Click"
                                    IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Группа: История -->
                <GroupBox Header="📜 История">
                    <Grid>
                        <ListView x:Name="ListViewHistory" 
                                  Height="200"
                                  FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Номер" Width="100" DisplayMemberBinding="{Binding Number}"/>
                                    <GridViewColumn Header="Регион" Width="60" DisplayMemberBinding="{Binding Region}"/>
                                    <GridViewColumn Header="Точность" Width="70" DisplayMemberBinding="{Binding Confidence}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button x:Name="BtnExport" 
                                Content="📎 Экспорт CSV"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnExport_Click"
                                Height="30"
                                Margin="0,5,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- Статус бар -->
                <Border Background="#252526" 
                        CornerRadius="5" 
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LblStats" 
                                   Text="📊 Распознано: 0"
                                   FontSize="12"/>
                        <TextBlock x:Name="LblStatus" 
                                   Text="✅ Готов к работе"
                                   FontSize="12"
                                   Foreground="{StaticResource SuccessColor}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>